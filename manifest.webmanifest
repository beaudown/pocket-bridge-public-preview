{
  "id": ".",
  "name": "Pocket Bridge",
  "short_name": "Bridge",
  "description": "Private transfers between your devices",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "background_color": "#101415",
  "theme_color": "#101415",
  "shortcuts": [
    { "name": "Share text", "short_name": "Text", "url": ".#compose=text", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Share a link", "short_name": "Link", "url": ".#compose=link", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "shared",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "files", "accept": ["*/*"] }] }
  }
}
